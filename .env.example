# 12-word BIP39 seed phrase of your test Wallet (https://github.com/broxus/ever-wallet-contract), account #0.
# Leave empty: run.sh will generate a new one and save it here.
# !!! Never commit .env !!!
PHRASE=""

# Tycho testnet JRPC endpoint (used for deployment, and for the load if LOAD_ENDPOINTS is empty)
JRPC_ENDPOINT="https://rpc-testnet.tychoprotocol.com/rpc"

# Endpoints that receive the load, comma or space separated.
# A bare host/IP expands to http://<host>:8080/rpc, full URLs are used as is.
# Example: LOAD_ENDPOINTS="10.0.0.1,10.0.0.2"  or  LOAD_ENDPOINTS="http://10.0.0.1:8080/rpc"
LOAD_ENDPOINTS=""
# rr       - one client, requests are spread round-robin across endpoints
# distinct - one worker per endpoint, RPS is split evenly between them
ENDPOINT_MODE=rr

# How many wallets to deploy and how many test tokens to put on each.
# Required balance on your wallet: WALLETS * (BALANCE + 1) + 10
WALLETS=100
BALANCE=2

# Load: every wallet sends ITERATIONS transfers to random wallets, RPS is the total rate (tx/s).
RPS=50
ITERATIONS=100

# nekroddos git branch/tag/commit to build
NEKRODDOS_REF=master
